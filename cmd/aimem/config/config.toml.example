ollamaHost = "http://localhost:11434"
embeddingModel = "embeddinggemma-2:740m"
summarizationModel = "gemma4:e2b"

# How many results to search
topK = 5

# The minimum cosine similarity for a fact to be returned by recall
# min: 0
# max: 1
similarityThreshold = 0.5

# Embedding model dimensions
# Do not change this value if DB is initialized
dimensions = 768

# MCP HTTP transport host
mcpHttpHost = "127.0.0.1:8090"
