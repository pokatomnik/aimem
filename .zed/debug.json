// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Run",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    // For Delve, the program can be a package name
    "program": "./cmd/aimem",
    "args": ["web"],
    "env": {
      // Example values.
      "AIMEM_LLM_HOST": "https://example.com",
      "AIMEM_LLM_API_KEY": "sk-*******************",
      "AIMEM_SUMMARIZATION_MODEL": "deepseek-flash",
      "AIMEM_TOP_K": "5",
      "AIMEM_SIMILARITY_THRESHOLD": "0.5",
      "AIMEM_DIMENSIONS": "768",
      "AIMEM_WEB_HTTP_HOST": "127.0.0.1:8888",
      "AIMEM_QDRANT_HOST": "https://*************************.eu-central-1-0.aws.cloud.qdrant.io",
      "AIMEM_QDRANT_API_KEY": "*****************************************",
      "AIMEM_USERS_JSON": "[{\"id\":\"user\",\"tokens\":[\"**********************\"]}]",
    },
    // "buildFlags": [],
  },
]
