# Настройки Qdrant для aimem.
#
# Скопируйте в `.env` и правьте по необходимости:
#
#   cp .env.example .env
#
# Docker Compose читает `.env` из каталога с `docker-compose.yaml` автоматически.
# Переменную можно не задавать — тогда действует дефолт. Пустое значение
# (`QDRANT_LOG_LEVEL=`) тоже даёт дефолт.
#
# `.env` в `.gitignore`, `.env.example` — общий шаблон в репозитории.


# --- Образ -------------------------------------------------------------------
# Версия Qdrant. Меняйте осознанно: мажорные обновления могут требовать
# миграции данных в volume `qdrant_storage`.
QDRANT_VERSION=v1.15.4


# --- Порты на хосте ----------------------------------------------------------
# HTTP (REST) API. По нему работают `qdrant/go-client` и большинство клиентов.
QDRANT_HTTP_PORT=6333
# gRPC API. Быстрее REST; для него нужен клиент, умеющий gRPC.
QDRANT_GRPC_PORT=6334

# Адрес, на котором публикуются порты. 127.0.0.1 — только с этой машины.
# 0.0.0.0 открывает базу наружу — тогда обязательно включите QDRANT_API_KEY.
QDRANT_HTTP_HOST=127.0.0.1
QDRANT_GRPC_HOST=127.0.0.1


# --- Аутентификация ----------------------------------------------------------
# ВАЖНО: просто вписать ключ здесь недостаточно. У Qdrant api_key — это
# Option<String>, а пустая строка считается ЗАДАННЫМ ключом (проверка
# включится с пустым паролем). Поэтому в `docker-compose.yaml` строки с
# QDRANT__SERVICE__API_KEY закомментированы.
#
# Чтобы включить аутентификацию:
#   1. впишите ключ здесь;
#   2. раскомментируйте две строки QDRANT__SERVICE__API_KEY в compose;
#   3. `docker compose up -d` — и передайте тот же ключ приложению.
#
# Оставьте пустым, если аутентификация не нужна (обычный локальный запуск).
QDRANT_API_KEY=
# Отдельный ключ только для чтения. Та же процедура, что и выше.
QDRANT_READ_ONLY_API_KEY=


# --- Хранилище ---------------------------------------------------------------
# true (дефолт Qdrant) — payload (summary/fact/created_at) и его индексы
# хранятся на диске. false — в памяти: быстрее, но данные должны туда влезать.
QDRANT_ON_DISK_PAYLOAD=true


# --- Логи и телеметрия -------------------------------------------------------
# TRACE, DEBUG, INFO, WARN, ERROR.
QDRANT_LOG_LEVEL=INFO
# false (дефолт Qdrant) — отправлять статистику вендору; true — не отправлять.
QDRANT_TELEMETRY_DISABLED=false
