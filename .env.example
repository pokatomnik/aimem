# Qdrant settings for aimem.
#
# Copy to `.env` and edit as needed:
#
#   cp .env.example .env
#
# Docker Compose reads `.env` from the directory holding `docker-compose.yaml`
# automatically. A variable may be left out — the default applies then. An empty
# value (`QDRANT_LOG_LEVEL=`) also gives the default.
#
# `.env` is in `.gitignore`, `.env.example` is the shared template in the repo.


# --- Image -------------------------------------------------------------------
# Qdrant version. Bump it deliberately: major upgrades may need a data migration
# inside the `qdrant_storage` volume.
QDRANT_VERSION=v1.15.4


# --- Host ports --------------------------------------------------------------
# HTTP (REST) API. `qdrant/go-client` and most clients speak it.
QDRANT_HTTP_PORT=6333
# gRPC API. Faster than REST; it needs a client that speaks gRPC.
QDRANT_GRPC_PORT=6334

# Address the ports are published on. 127.0.0.1 — this machine only.
# 0.0.0.0 exposes the database beyond it — then you must enable QDRANT_API_KEY.
QDRANT_HTTP_HOST=127.0.0.1
QDRANT_GRPC_HOST=127.0.0.1


# --- Authentication ----------------------------------------------------------
# IMPORTANT: writing the key here is not enough. Qdrant's api_key is an
# Option<String>, and an empty string counts as a KEY BEING SET (checking turns
# on with a blank password). That is why the QDRANT__SERVICE__API_KEY lines in
# `docker-compose.yaml` are commented out.
#
# To enable authentication:
#   1. put the key here;
#   2. uncomment the two QDRANT__SERVICE__API_KEY lines in compose;
#   3. `docker compose up -d` — and pass the same key to the application.
#
# Leave empty if authentication is not needed (the usual local run).
QDRANT_API_KEY=
# A separate read-only key. Same procedure as above.
QDRANT_READ_ONLY_API_KEY=


# --- Storage -----------------------------------------------------------------
# true (Qdrant's default) — the payload (summary/fact/created_at) and its
# indexes are kept on disk. false — in memory: faster, but the data has to fit.
QDRANT_ON_DISK_PAYLOAD=true


# --- Logging and telemetry ---------------------------------------------------
# TRACE, DEBUG, INFO, WARN, ERROR.
QDRANT_LOG_LEVEL=INFO
# false (Qdrant's default) — report statistics to the vendor; true — do not.
QDRANT_TELEMETRY_DISABLED=false
